---
import BaseLayout from "../layouts/BaseLayout.astro";
import Stats from "../components/Manual/Stats.astro";
import { SECTIONS } from "../components/Manual/sections";

const toc = [
  ...SECTIONS.map(({ id, title }) => ({ id, title })),
  { id: "damage-table", title: "Damage table" },
];
---

<BaseLayout
  title="Manual"
  description="How to play Earth Doom: credits and titanium, land, units, energy, attacking and the damage table."
>
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <header class="border-b border-line pt-[clamp(3.5rem,3rem+3vw,6rem)] pb-[clamp(2.5rem,2rem+2vw,4rem)]">
      <h1 class="text-display font-bold text-ink">Earth Doom manual</h1>
      <p class="mt-4 max-w-2xl text-lg text-soft">
        A walk through your first days, from the first credits to your first
        battle. Read it in order, or jump to the part you need.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-8 pt-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-16 lg:pt-14">
      <nav class="self-start lg:sticky lg:top-24" aria-label="Manual contents">
        <!-- A collapsible card on small screens, a fixed list on large ones. -->
        <details
          class="toc-details group max-lg:rounded-lg max-lg:border max-lg:border-line max-lg:bg-panel max-lg:px-4 max-lg:py-3.5"
          open
        >
          <summary
            class="cursor-pointer pb-3 text-xs font-medium text-muted max-lg:pb-0 max-lg:text-[0.9375rem] max-lg:font-semibold max-lg:text-ink max-lg:group-open:pb-3 lg:pointer-events-none lg:list-none lg:[&::-webkit-details-marker]:hidden"
          >
            Contents
          </summary>
          <ol class="border-l border-line">
            {
              toc.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    data-toc={item.id}
                    class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-sm leading-[1.4] text-muted transition-colors duration-150 ease-out hover:text-ink aria-[current=true]:border-accent aria-[current=true]:font-semibold aria-[current=true]:text-ink"
                  >
                    {item.title}
                  </a>
                </li>
              ))
            }
          </ol>
        </details>
      </nav>

      <article class="min-w-0 divide-y divide-line *:first:pt-0">
        {
          SECTIONS.map((section) => (
            <section id={section.id} class="scroll-mt-22 py-12" aria-labelledby={`${section.id}-title`}>
              <h2
                id={`${section.id}-title`}
                class="text-[clamp(1.5rem,1.3rem+0.8vw,2rem)] leading-[1.15] font-bold text-ink"
              >
                {section.title}
              </h2>
              <div class="prose mt-5" set:html={section.content} />
            </section>
          ))
        }
        <Stats />
      </article>
    </div>
  </div>
</BaseLayout>

<script>
  // Scroll-spy: mark the section being read in the contents list.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")].map((a) => [a.dataset.toc!, a]),
  );
  let current: HTMLAnchorElement | undefined;
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        current?.removeAttribute("aria-current");
        current = links.get(entry.target.id);
        current?.setAttribute("aria-current", "true");
      }
    },
    { rootMargin: "-20% 0px -70% 0px" },
  );
  links.forEach((_, id) => {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  });

  // On small screens the contents list starts closed.
  if (matchMedia("(max-width: 1023px)").matches) {
    document.querySelector<HTMLDetailsElement>(".toc-details")?.removeAttribute("open");
  }
</script>
