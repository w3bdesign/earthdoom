---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Blog" description="News and notes from Earth Doom." noindex>
  <div class="mx-auto max-w-3xl px-4 pt-14 md:px-8 md:pt-20">
    <h1 class="section-title">Blog</h1>
    <ol class="mt-10 border-t border-line">
      {
        posts.map((post) => (
          <li class="border-b border-line">
            <a href={`/blog/${post.id}/`} class="post-link group block py-6">
              <span class="text-sm text-muted">
                <FormattedDate date={post.data.pubDate} />
              </span>
              <span class="mt-1 block text-xl font-semibold text-ink group-hover:text-accent-strong">
                {post.data.title}
              </span>
              <span class="mt-2 block text-soft">{post.data.description}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
