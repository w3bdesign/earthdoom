---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Index/Hero.astro";
import GameLoop from "../components/Index/GameLoop.astro";
import ManualIndex from "../components/Index/ManualIndex.astro";
import FinalCall from "../components/Index/FinalCall.astro";
import { PLAY_URL, SITE_DESCRIPTION, SITE_TITLE } from "../consts";

// Structured data so search engines know this is a free browser game.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: SITE_TITLE,
      url: Astro.site?.href,
    },
    {
      "@type": "VideoGame",
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      url: Astro.site?.href,
      genre: ["Strategy", "Massively multiplayer online game"],
      gamePlatform: "Web browser",
      applicationCategory: "Game",
      playMode: "MultiPlayer",
      offers: {
        "@type": "Offer",
        price: 0,
        priceCurrency: "USD",
        url: PLAY_URL,
        availability: "https://schema.org/InStock",
      },
    },
  ],
};
---

<BaseLayout title="Earth Doom · Free browser strategy game" showDesktopNav={false}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <Hero />
  <GameLoop />
  <ManualIndex />
  <FinalCall />
</BaseLayout>
