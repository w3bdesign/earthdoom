---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/common/Button.astro";
import { PLAY_URL } from "../consts";
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <div class="mx-auto max-w-3xl px-4 py-24 md:px-8 md:py-32">
    <h1 class="section-title">Nothing here but empty land.</h1>
    <p class="mt-4 max-w-xl text-lg text-soft">
      Error 404: the page you were looking for does not exist or has moved.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <Button href="/" size="lg">Back to home</Button>
      <Button href={PLAY_URL} size="lg" variant="secondary">Play now</Button>
    </div>
  </div>
</BaseLayout>
