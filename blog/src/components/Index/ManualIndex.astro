---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { SECTIONS } from "../Manual/sections";
---

<section class="mx-auto max-w-7xl px-4 pt-28 md:px-8" aria-labelledby="manual-title">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="max-w-2xl">
      <h2 id="manual-title" class="text-display font-bold text-ink">The manual</h2>
      <p class="mt-4 text-lg text-soft">
        Everything above, step by step, from your first tax collectors to
        reading a combat report.
      </p>
    </div>
    <a href="/manual/" class="inline-flex items-center gap-2 font-semibold text-accent hover:text-accent-strong">
      Open the manual <ArrowRight size={18} aria-hidden="true" />
    </a>
  </div>

  <ol class="arrive mt-10 grid border-t border-line sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-3">
    {
      SECTIONS.map((section) => (
        <li>
          <a
            href={`/manual/#${section.id}`}
            class="group flex min-h-15 items-center justify-between gap-4 border-b border-line font-medium text-ink transition-colors duration-150 ease-out hover:text-accent-strong"
          >
            <span>{section.title}</span>
            <ArrowRight
              size={16}
              aria-hidden="true"
              class="text-field transition-[translate,color] duration-200 ease-out-expo group-hover:translate-x-1 group-hover:text-accent"
            />
          </a>
        </li>
      ))
    }
  </ol>
</section>
