---
import { Picture } from "astro:assets";
import Check from "@lucide/astro/icons/check";
import spaceship from "../../assets/spaceship.jpg";
import Button from "../common/Button.astro";
import { PLAY_URL } from "../../consts";

const facts = ["Free to play", "Conquer your enemies", "Instant action"];
---

<section class="hero" aria-labelledby="hero-title">
  <Picture
    src={spaceship}
    formats={["avif", "webp"]}
    widths={[768, 1280, 1920, 2560]}
    sizes="(max-aspect-ratio: 3/2) 135vh, 100vw"
    alt="A squadron of fighter spacecraft streaking above the clouds at sunrise, under laser fire."
    loading="eager"
    fetchpriority="high"
    class="hero-art"
  />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-copy mx-auto w-full max-w-7xl px-4 md:px-8">
    <h1 id="hero-title" class="hero-title">
      <span class="text-muted">Dominate your enemies</span>
      Take their land.
    </h1>
    <p class="hero-lede">
      Earth Doom is a strategy game, explore and dominate the world and conquer your enemies!
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <Button href={PLAY_URL} size="lg">Play now</Button>
      <Button href="/manual/" size="lg" variant="secondary">Read the manual</Button>
    </div>
    <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-sm text-soft">
      {
        facts.map((fact) => (
          <li class="flex items-center gap-2">
            <Check size={16} class="text-friendly" aria-hidden="true" />
            {fact}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: min(calc(100svh - 4rem), 52rem);
    padding-block: 6rem 5rem;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
  }

  .hero :global(.hero-art) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 50%;
  }

  /* Solid navy on the copy side, clearing towards the art. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        90deg,
        rgb(10 15 22 / 0.94) 0%,
        rgb(10 15 22 / 0.86) 34%,
        rgb(10 15 22 / 0.35) 62%,
        rgb(10 15 22 / 0.1) 100%
      ),
      linear-gradient(0deg, var(--color-ground) 0%, rgb(10 15 22 / 0) 26%);
  }

  .hero-title {
    color: var(--color-ink);
    /* Scales with viewport so each line fits on one row on phones. */
    font-size: clamp(1.5rem, 6.8vw, 5rem);
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .hero-title span {
    display: block;
    white-space: nowrap;
  }

  .hero-lede {
    max-width: 34rem;
    margin-top: 1.5rem;
    color: var(--color-soft);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  @media (max-width: 1023px) {
    .hero {
      align-items: flex-end;
      min-height: 0;
      padding-block: 14rem 3.5rem;
    }
    .hero :global(.hero-art) {
      object-position: 40% 50%;
    }
    .hero-scrim {
      background: linear-gradient(
        0deg,
        var(--color-ground) 0%,
        rgb(10 15 22 / 0.94) 52%,
        rgb(10 15 22 / 0.35) 82%,
        rgb(10 15 22 / 0.15) 100%
      );
    }
  }
</style>
