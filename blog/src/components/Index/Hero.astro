---
import { Picture } from "astro:assets";
import Check from "@lucide/astro/icons/check";
import spaceship from "../../assets/spaceship.jpg";
import Button from "../common/Button.astro";
import { PLAY_URL } from "../../consts";

const facts = ["Free to play", "Conquer your enemies", "Instant action"];
---

<section
  class="relative isolate flex items-end overflow-hidden border-b border-line pt-56 pb-14 lg:min-h-[min(calc(100svh-4rem),52rem)] lg:items-center lg:pt-24 lg:pb-20"
  aria-labelledby="hero-title"
>
  <Picture
    src={spaceship}
    formats={["avif", "webp"]}
    widths={[768, 1280, 1920, 2560]}
    sizes="(max-aspect-ratio: 3/2) 135vh, 100vw"
    alt="A squadron of fighter spacecraft streaking above the clouds at sunrise, under laser fire."
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 size-full object-cover object-[40%_50%] lg:object-[62%_50%]"
  />
  <!-- Scrim: solid navy behind the copy, clearing towards the art. -->
  <div
    class="absolute inset-0 -z-10 bg-linear-to-t from-ground via-ground/94 via-52% to-ground/15 lg:bg-linear-to-r lg:from-ground/94 lg:via-ground/35 lg:via-62% lg:to-ground/10"
    aria-hidden="true"
  ></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 hidden h-1/4 bg-linear-to-t from-ground lg:block" aria-hidden="true"></div>

  <div class="mx-auto w-full max-w-7xl px-4 md:px-8">
    <h1
      id="hero-title"
      class="text-[clamp(1.5rem,6.8vw,5rem)] leading-none font-[750] tracking-[-0.02em] text-ink *:block *:whitespace-nowrap"
    >
      <span class="text-muted">Dominate your enemies</span>
      <span>Take their land</span>
    </h1>
    <p class="mt-6 text-[clamp(1.0625rem,1rem+0.3vw,1.25rem)] leading-relaxed text-soft">
      Earth Doom is a strategy game, explore and dominate the world and conquer your enemies!
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <Button href={PLAY_URL} size="lg">Play now</Button>
      <Button href="/manual/" size="lg" variant="secondary">Read the manual</Button>
    </div>
    <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-sm text-soft">
      {
        facts.map((fact) => (
          <li class="flex items-center gap-2">
            <Check size={16} class="text-friendly" aria-hidden="true" />
            {fact}
          </li>
        ))
      }
    </ul>
  </div>
</section>
