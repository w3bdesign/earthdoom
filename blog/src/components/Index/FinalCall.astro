---
import { Picture } from "astro:assets";
import spaceship from "../../assets/spaceship.jpg";
import Button from "../common/Button.astro";
import { PLAY_URL } from "../../consts";
---

<section class="mx-auto max-w-7xl px-4 pt-28 md:px-8" aria-labelledby="final-title">
  <div class="relative isolate overflow-hidden rounded-lg border border-line bg-panel p-[clamp(2rem,1rem+4vw,4.5rem)]">
    <Picture
      src={spaceship}
      formats={["avif", "webp"]}
      widths={[768, 1280, 1920]}
      sizes="(min-width: 1280px) 1216px, 100vw"
      alt=""
      class="absolute inset-0 -z-10 size-full object-cover object-[85%_72%] opacity-30 [mask-image:linear-gradient(0deg,transparent_20%,#000_100%)] md:opacity-55 md:[mask-image:linear-gradient(90deg,transparent_15%,#000_75%)]"
    />
    <div class="max-w-xl text-center md:text-left">
      <h2 id="final-title" class="text-display font-bold text-ink">The land won’t take itself.</h2>
      <p class="mx-auto mt-4 max-w-md text-soft md:mx-0">
        Sign up free, build your first tax collectors and start scouting
        for land. Your rivals already have.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:justify-center md:justify-start">
        <Button href={PLAY_URL} size="lg">Play now</Button>
        <Button href="/manual/#getting-started" size="lg" variant="secondary">How to start</Button>
      </div>
    </div>
  </div>
</section>
