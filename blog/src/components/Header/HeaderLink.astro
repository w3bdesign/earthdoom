---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;

const normalise = (path: string) => path.replace(/\/$/, "") || "/";
const isActive = normalise(String(href)) === normalise(Astro.url.pathname);
---

<a
  href={href}
  class:list={[
    "group relative inline-flex h-10 items-center px-3 text-sm font-medium text-muted transition-colors duration-150 ease-out",
    "hover:text-ink aria-[current=page]:font-semibold aria-[current=page]:text-ink",
    className,
  ]}
  aria-current={isActive ? "page" : undefined}
  {...props}
>
  <slot />
  <!-- Underline grows from the left on hover; stays full width in accent on the current page. -->
  <span
    class:list={[
      "absolute inset-x-3 bottom-1 h-0.5 origin-left scale-x-0 rounded-[1px] bg-ink transition-transform duration-240 ease-out-expo",
      "group-hover:scale-x-100 group-aria-[current=page]:scale-x-100 group-aria-[current=page]:bg-accent",
      // Slides between links on page change (desktop only; the mobile menu is closed during navigation).
      isActive && "md:[view-transition-name:nav-underline]",
    ]}
    aria-hidden="true"
  ></span>
</a>
