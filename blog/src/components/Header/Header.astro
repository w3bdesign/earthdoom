---
import Menu from "@lucide/astro/icons/menu";
import X from "@lucide/astro/icons/x";
import HeaderLink from "./HeaderLink.astro";
import Wordmark from "./Wordmark.astro";
import Button from "../common/Button.astro";
import { NAV_LINKS, PLAY_URL } from "../../consts";

interface Props {
  /**
   * Show the desktop navigation links and Play button. The mobile menu is
   * always rendered so the header looks the same on every page on small screens.
   */
  showDesktopNav?: boolean;
}

const { showDesktopNav = true } = Astro.props;
---

<header class="site-header">
  <div class="header-bg" aria-hidden="true"></div>

  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 md:px-8">
    <Wordmark />

    {showDesktopNav && (
    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {NAV_LINKS.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
      <Button href={PLAY_URL} class="ml-3">Play now</Button>
    </nav>
    )}

    <button
      type="button"
      class="menu-toggle md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <span class="menu-icon menu-icon-open"><Menu size={22} aria-hidden="true" /></span>
      <span class="menu-icon menu-icon-close"><X size={22} aria-hidden="true" /></span>
    </button>
  </div>

  <!-- Manual popover: opening and closing are driven by the script below, so
       the menu is only hidden after its close animation has finished. -->
  <div id="mobile-menu" popover="manual" class="mobile-menu">
    <div class="mobile-menu-panel">
      <nav aria-label="Main" class="px-4 pt-3 pb-6">
        <ul class="flex flex-col items-start gap-1">
          {
            NAV_LINKS.map((link) => (
              <li class="menu-item">
                <HeaderLink href={link.href} class="!h-12 !text-base">
                  {link.label}
                </HeaderLink>
              </li>
            ))
          }
          <li class="menu-item mt-4 w-full">
            <Button href={PLAY_URL} size="lg" class="w-full">Play now</Button>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--color-line);
  }
  /* Background and blur on their own layer so the script can animate the
     colour (translucent normally, solid while the menu is open). */
  .header-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: rgb(10 15 22 / 0.86);
    backdrop-filter: blur(12px) saturate(140%);
  }

  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    color: var(--color-ink);
    transition: background-color 150ms ease-out;
  }
  .menu-toggle:hover {
    background: var(--color-raised);
  }
  @media (min-width: 768px) {
    .menu-toggle {
      display: none;
    }
  }
  .menu-icon {
    grid-area: 1 / 1;
    display: grid;
  }
  .menu-icon-close {
    opacity: 0;
  }

  /* Below the header, which stays visible. The popover itself is the dark
     overlay; the panel inside unrolls down from the header edge. Start states
     match the closed menu; the script animates everything from here. */
  .mobile-menu {
    /* Overlap the header's 1px bottom border so no seam shows the page. */
    inset: calc(4rem - 1px) 0 0 0;
    width: 100%;
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(0 0 0 / 0.6);
    color: var(--color-ink);
    opacity: 0;
  }
  .mobile-menu-panel {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-rail);
    box-shadow: 0 12px 32px -8px rgb(0 0 0 / 0.7);
    clip-path: inset(0 0 100% 0);
  }
  .menu-item {
    opacity: 0;
  }
</style>

<script>
  import { createToggle } from "../../scripts/animation";

  const header = document.querySelector<HTMLElement>(".site-header")!;
  const menu = document.getElementById("mobile-menu")!;
  const toggle = header.querySelector<HTMLButtonElement>(".menu-toggle")!;
  const $ = (selector: string) => header.querySelector(selector)!;

  // Each animated part, with its open and closed values.
  const animateMenu = createToggle([
    { target: menu, open: { opacity: 1 }, closed: { opacity: 0 } },
    { target: $(".header-bg"), open: { backgroundColor: "rgb(12, 23, 38)" }, closed: { backgroundColor: "rgba(10, 15, 22, 0.86)" } },
    { target: $(".mobile-menu-panel"), open: { clipPath: "inset(0px 0px -48px 0px)" }, closed: { clipPath: "inset(0px 0px 100% 0px)" } },
    { target: [...menu.querySelectorAll(".menu-item")], open: { opacity: 1, y: 0 }, closed: { opacity: 0, y: 8 }, stagger: 0.03 },
    { target: $(".menu-icon-open"), open: { opacity: 0, rotate: 90 }, closed: { opacity: 1, rotate: 0 } },
    { target: $(".menu-icon-close"), open: { opacity: 1, rotate: 0 }, closed: { opacity: 0, rotate: -90 } },
  ]);

  let isOpen = false;

  /** Open or close the menu. `instant` skips the animation (page changes, resizing). */
  async function setOpen(open: boolean, instant = false) {
    isOpen = open;
    toggle.ariaExpanded = String(open);
    toggle.ariaLabel = open ? "Close menu" : "Open menu";
    const shown = () => menu.matches(":popover-open");
    if (open && !shown()) menu.showPopover();

    // Hide only after closing has finished, unless the menu was reopened meanwhile.
    const finished = await animateMenu(open, instant);
    if (!open && finished && shown()) menu.hidePopover();
  }

  setOpen(false, true);

  toggle.addEventListener("click", () => setOpen(!isOpen));
  // Taps on the dark overlay land on the popover itself, outside the panel.
  menu.addEventListener("click", (event) => event.target === menu && setOpen(false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen) {
      setOpen(false);
      toggle.focus();
    }
  });

  // Close instantly on page change, back/forward restore and resize to desktop,
  // so the menu never shows up half-closed in the page transition.
  window.addEventListener("pageswap", () => setOpen(false, true));
  window.addEventListener("pagehide", () => setOpen(false, true));
  matchMedia("(min-width: 768px)").addEventListener("change", (event) => event.matches && setOpen(false, true));
</script>

