---
import Menu from "@lucide/astro/icons/menu";
import X from "@lucide/astro/icons/x";
import HeaderLink from "./HeaderLink.astro";
import Wordmark from "./Wordmark.astro";
import Button from "../common/Button.astro";
import { NAV_LINKS, PLAY_URL } from "../../consts";

interface Props {
  /**
   * Show the desktop navigation links and Play button. The mobile menu is
   * always rendered so the header looks the same on every page on small screens.
   */
  showDesktopNav?: boolean;
}

const { showDesktopNav = true } = Astro.props;
---

<header class="site-header">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 md:px-8">
    <Wordmark />

    {showDesktopNav && (
    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {NAV_LINKS.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
      <Button href={PLAY_URL} class="ml-3">Play now</Button>
    </nav>
    )}

    <button
      type="button"
      class="menu-toggle md:hidden"
      popovertarget="mobile-menu"
      aria-label="Menu"
    >
      <span class="menu-icon menu-icon-open"><Menu size={22} aria-hidden="true" /></span>
      <span class="menu-icon menu-icon-close"><X size={22} aria-hidden="true" /></span>
    </button>
  </div>

  <div id="mobile-menu" popover class="mobile-menu">
    <div class="mobile-menu-panel">
      <nav aria-label="Main" class="px-4 pt-3 pb-6">
        <ul class="flex flex-col items-start gap-1" style={`--n: ${NAV_LINKS.length}`}>
          {
            NAV_LINKS.map((link, i) => (
              <li class="menu-item" style={`--i: ${i}`}>
                <HeaderLink href={link.href} class="!h-12 !text-base">
                  {link.label}
                </HeaderLink>
              </li>
            ))
          }
          <li class="menu-item mt-4 w-full" style={`--i: ${NAV_LINKS.length}`}>
            <Button href={PLAY_URL} size="lg" class="w-full">Play now</Button>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--color-line);
  }
  /* The blur lives on a pseudo-element, not the header itself. backdrop-filter
     on the header would make it the containing block for the fixed-position
     menu: in browsers without `overlay` transitions (Safari, Firefox) the
     closing menu leaves the top layer at once and collapses into the 64px
     header, so the close animation never shows. */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(10 15 22 / 0.86);
    backdrop-filter: blur(12px) saturate(140%);
    /* Closing: return to translucent once the panel has rolled up. */
    transition: background-color 220ms ease-in 80ms;
  }
  /* While the menu is open the header goes solid so page text doesn't show through. */
  .site-header:has(#mobile-menu:popover-open)::before {
    background: var(--color-rail);
    transition: background-color 280ms ease-out;
  }

  /* Hamburger that morphs into an X in place while the menu is open. */
  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    color: var(--color-ink);
    transition: background-color 150ms ease-out;
  }
  .menu-toggle:hover {
    background: var(--color-raised);
  }
  @media (min-width: 768px) {
    .menu-toggle {
      display: none;
    }
  }
  .menu-icon {
    grid-area: 1 / 1;
    display: grid;
    transition:
      opacity 200ms var(--ease-out-expo),
      rotate 280ms var(--ease-out-expo);
  }
  .menu-icon-close {
    opacity: 0;
    rotate: -90deg;
  }
  .site-header:has(#mobile-menu:popover-open) .menu-icon-open {
    opacity: 0;
    rotate: 90deg;
  }
  .site-header:has(#mobile-menu:popover-open) .menu-icon-close {
    opacity: 1;
    rotate: 0deg;
  }

  /* The popover sits below the header (which stays visible) and acts as the
     scrim. The panel inside unrolls down from the header edge.

     Closing mirrors opening in reverse order:
       0-190ms    items fade out and drop, last one first
       80-300ms   panel rolls back up and the scrim fades
       300ms      popover removed (display/overlay must outlast everything) */
  .mobile-menu {
    /* Overlap the header's 1px bottom border so no sub-pixel seam shows the page. */
    inset: calc(4rem - 1px) 0 0 0;
    width: 100%;
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(0 0 0 / 0.6);
    color: var(--color-ink);
    opacity: 0;
    transition:
      opacity 220ms ease-in 80ms,
      overlay 300ms allow-discrete,
      display 300ms allow-discrete;
  }
  .mobile-menu:popover-open {
    opacity: 1;
    transition:
      opacity 280ms ease-out,
      overlay 280ms allow-discrete,
      display 280ms allow-discrete;
  }
  @starting-style {
    .mobile-menu:popover-open {
      opacity: 0;
    }
  }

  .mobile-menu-panel {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-rail);
    box-shadow: 0 12px 32px -8px rgb(0 0 0 / 0.7);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 220ms ease-in 80ms;
  }
  .mobile-menu:popover-open .mobile-menu-panel {
    /* Leave room below for the shadow. */
    clip-path: inset(0 0 -3rem 0);
    transition: clip-path 280ms var(--ease-out-expo);
  }
  @starting-style {
    .mobile-menu:popover-open .mobile-menu-panel {
      clip-path: inset(0 0 100% 0);
    }
  }

  .menu-item {
    opacity: 0;
    translate: 0 0.5rem;
    /* Reverse stagger: the last item (the Play button) leaves first. */
    transition:
      opacity 140ms ease-in,
      translate 140ms ease-in;
    transition-delay: calc((var(--n, 0) - var(--i, 0)) * 25ms);
  }
  .mobile-menu:popover-open .menu-item {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 280ms var(--ease-out-expo),
      translate 280ms var(--ease-out-expo);
    transition-delay: calc(60ms + var(--i, 0) * 30ms);
  }
  @starting-style {
    .mobile-menu:popover-open .menu-item {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }

  /* Set just before navigating: close everything instantly so the page
     transition snapshot shows a closed menu, not one mid-animation. */
  .site-header.instant,
  .site-header.instant::before,
  .site-header.instant :global(*) {
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Keep only a short, undelayed fade of the scrim. */
    .mobile-menu,
    .mobile-menu:popover-open {
      transition:
        opacity 150ms ease-out,
        overlay 150ms allow-discrete,
        display 150ms allow-discrete;
    }
    .site-header::before,
    .site-header:has(#mobile-menu:popover-open)::before,
    .menu-icon,
    .mobile-menu-panel,
    .mobile-menu:popover-open .mobile-menu-panel,
    .menu-item,
    .mobile-menu:popover-open .menu-item {
      transition: none;
    }
    .menu-icon,
    .site-header:has(#mobile-menu:popover-open) .menu-icon {
      rotate: 0deg;
    }
    .mobile-menu-panel,
    .mobile-menu:popover-open .mobile-menu-panel {
      clip-path: none;
    }
    .menu-item,
    .mobile-menu:popover-open .menu-item {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>

<script>
  const menu = document.getElementById("mobile-menu");
  const header = document.querySelector<HTMLElement>(".site-header");
  if (menu && header) {
    const supportsPageSwap = "onpageswap" in window;

    menu.addEventListener("click", (event) => {
      const target = event.target as Element;
      // The scrim is part of the popover, so light dismiss won't fire for it.
      if (target === menu) menu.hidePopover();
      // Links: where pageswap exists, the menu is closed there instead (instantly).
      else if (target.closest("a") && !supportsPageSwap) menu.hidePopover();
    });

    // Fires right before the browser snapshots this page for the view transition.
    window.addEventListener("pageswap", () => {
      if (!menu.matches(":popover-open")) return;
      header.classList.add("instant");
      menu.hidePopover();
    });
    // Coming back via back/forward cache: restore normal animations.
    window.addEventListener("pageshow", () => header.classList.remove("instant"));

    // The toggle disappears at desktop width; don't leave the menu stranded open.
    matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches && menu.matches(":popover-open")) menu.hidePopover();
    });
  }
</script>
