---
import Menu from "@lucide/astro/icons/menu";
import X from "@lucide/astro/icons/x";
import HeaderLink from "./HeaderLink.astro";
import Wordmark from "./Wordmark.astro";
import Button from "../common/Button.astro";
import { NAV_LINKS, PLAY_URL } from "../../consts";

interface Props {
  /**
   * Show the desktop navigation links and Play button. The mobile menu is
   * always rendered so the header looks the same on every page on small screens.
   */
  showDesktopNav?: boolean;
}

const { showDesktopNav = true } = Astro.props;
---

<header class="site-header">
  <div class="header-bg" aria-hidden="true"></div>

  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 md:px-8">
    <Wordmark />

    {showDesktopNav && (
    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {NAV_LINKS.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
      <Button href={PLAY_URL} class="ml-3">Play now</Button>
    </nav>
    )}

    <button
      type="button"
      class="menu-toggle md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <span class="menu-icon menu-icon-open"><Menu size={22} aria-hidden="true" /></span>
      <span class="menu-icon menu-icon-close"><X size={22} aria-hidden="true" /></span>
    </button>
  </div>

  <!-- Manual popover: opening and closing are driven by the script below, so
       the menu is only hidden after its close animation has finished. -->
  <div id="mobile-menu" popover="manual" class="mobile-menu">
    <div class="mobile-menu-panel">
      <nav aria-label="Main" class="px-4 pt-3 pb-6">
        <ul class="flex flex-col items-start gap-1">
          {
            NAV_LINKS.map((link) => (
              <li class="menu-item">
                <HeaderLink href={link.href} class="!h-12 !text-base">
                  {link.label}
                </HeaderLink>
              </li>
            ))
          }
          <li class="menu-item mt-4 w-full">
            <Button href={PLAY_URL} size="lg" class="w-full">Play now</Button>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--color-line);
  }
  /* Background and blur on their own layer so the script can animate the
     colour (translucent normally, solid while the menu is open). */
  .header-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: rgb(10 15 22 / 0.86);
    backdrop-filter: blur(12px) saturate(140%);
  }

  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    color: var(--color-ink);
    transition: background-color 150ms ease-out;
  }
  .menu-toggle:hover {
    background: var(--color-raised);
  }
  @media (min-width: 768px) {
    .menu-toggle {
      display: none;
    }
  }
  .menu-icon {
    grid-area: 1 / 1;
    display: grid;
  }
  .menu-icon-close {
    opacity: 0;
  }

  /* Below the header, which stays visible. The popover itself is the dark
     overlay; the panel inside unrolls down from the header edge. Start states
     match the closed menu; the script animates everything from here. */
  .mobile-menu {
    /* Overlap the header's 1px bottom border so no seam shows the page. */
    inset: calc(4rem - 1px) 0 0 0;
    width: 100%;
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(0 0 0 / 0.6);
    color: var(--color-ink);
    opacity: 0;
  }
  .mobile-menu-panel {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-rail);
    box-shadow: 0 12px 32px -8px rgb(0 0 0 / 0.7);
    clip-path: inset(0 0 100% 0);
  }
  .menu-item {
    opacity: 0;
  }
</style>

<script>
  import { animate, stagger } from "motion";

  const header = document.querySelector<HTMLElement>(".site-header");
  const menu = document.getElementById("mobile-menu");
  const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");

  if (header && menu && toggle) {
    const bg = header.querySelector<HTMLElement>(".header-bg")!;
    const panel = menu.querySelector<HTMLElement>(".mobile-menu-panel")!;
    const items = [...menu.querySelectorAll<HTMLElement>(".menu-item")];
    const iconOpen = toggle.querySelector<HTMLElement>(".menu-icon-open")!;
    const iconClose = toggle.querySelector<HTMLElement>(".menu-icon-close")!;

    const EASE_OUT_EXPO: [number, number, number, number] = [0.16, 1, 0.3, 1];
    const BG_TRANSLUCENT = "rgba(10, 15, 22, 0.86)";
    const BG_SOLID = "rgb(12, 23, 38)"; // --color-rail
    const CLIP_CLOSED = "inset(0px 0px 100% 0px)";
    const CLIP_OPEN = "inset(0px 0px -48px 0px)"; // room below for the shadow
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

    let isOpen = false;
    let generation = 0; // bumps on every open/close so stale closes don't hide a reopened menu
    let running: Array<{ stop(): void }> = [];

    const stopAll = () => {
      running.forEach((animation) => animation.stop());
      running = [];
    };
    const play = <T extends { stop(): void }>(...animations: T[]) => {
      running.push(...animations);
      return Promise.all(animations);
    };

    const setExpanded = (expanded: boolean) => {
      toggle.setAttribute("aria-expanded", String(expanded));
      toggle.setAttribute("aria-label", expanded ? "Close menu" : "Open menu");
    };

    /** Put everything in the closed state with no animation. */
    const applyClosedState = () => {
      stopAll();
      menu.style.opacity = "0";
      panel.style.clipPath = CLIP_CLOSED;
      bg.style.backgroundColor = BG_TRANSLUCENT;
      for (const item of items) {
        item.style.opacity = "0";
        item.style.transform = "translateY(8px)";
      }
      iconOpen.style.opacity = "1";
      iconOpen.style.transform = "rotate(0deg)";
      iconClose.style.opacity = "0";
      iconClose.style.transform = "rotate(-90deg)";
    };

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key !== "Escape") return;
      closeMenu();
      toggle.focus();
    };

    function openMenu() {
      if (isOpen) return;
      isOpen = true;
      generation++;
      stopAll();
      setExpanded(true);
      if (!menu!.matches(":popover-open")) menu!.showPopover();
      document.addEventListener("keydown", onKeydown);

      const reduce = reducedMotion.matches;
      const ease = EASE_OUT_EXPO;
      play(
        animate(menu!, { opacity: 1 }, { duration: reduce ? 0.15 : 0.28, ease: "easeOut" }),
        animate(bg, { backgroundColor: BG_SOLID }, { duration: reduce ? 0 : 0.28, ease: "easeOut" }),
        animate(panel, { clipPath: CLIP_OPEN }, { duration: reduce ? 0 : 0.28, ease }),
        animate(
          items,
          { opacity: 1, transform: ["translateY(8px)", "translateY(0px)"] },
          reduce
            ? { duration: 0 }
            : { duration: 0.28, ease, delay: stagger(0.03, { startDelay: 0.06 }) },
        ),
        animate(
          iconOpen,
          { opacity: 0, transform: ["rotate(0deg)", "rotate(90deg)"] },
          { duration: reduce ? 0 : 0.28, ease },
        ),
        animate(
          iconClose,
          { opacity: 1, transform: ["rotate(-90deg)", "rotate(0deg)"] },
          { duration: reduce ? 0 : 0.28, ease },
        ),
      );
    }

    /**
     * Close in reverse: links leave last-first, then the panel rolls up and
     * the overlay fades. The popover is hidden only after all of that ends.
     */
    async function closeMenu({ instant = false } = {}) {
      if (!isOpen && !instant) return;
      isOpen = false;
      const current = ++generation;
      setExpanded(false);
      document.removeEventListener("keydown", onKeydown);

      if (instant) {
        applyClosedState();
        if (menu!.matches(":popover-open")) menu!.hidePopover();
        return;
      }

      stopAll();
      const reduce = reducedMotion.matches;
      await play(
        animate(
          items,
          { opacity: 0, transform: ["translateY(0px)", "translateY(8px)"] },
          reduce
            ? { duration: 0 }
            : { duration: 0.14, ease: "easeIn", delay: stagger(0.025, { from: "last" }) },
        ),
        animate(
          panel,
          { clipPath: CLIP_CLOSED },
          reduce ? { duration: 0 } : { duration: 0.22, ease: "easeIn", delay: 0.08 },
        ),
        animate(
          menu!,
          { opacity: 0 },
          reduce ? { duration: 0.15, ease: "easeOut" } : { duration: 0.22, ease: "easeIn", delay: 0.08 },
        ),
        animate(
          bg,
          { backgroundColor: BG_TRANSLUCENT },
          reduce ? { duration: 0 } : { duration: 0.22, ease: "easeIn", delay: 0.08 },
        ),
        animate(
          iconClose,
          { opacity: 0, transform: ["rotate(0deg)", "rotate(-90deg)"] },
          { duration: reduce ? 0 : 0.24, ease: EASE_OUT_EXPO },
        ),
        animate(
          iconOpen,
          { opacity: 1, transform: ["rotate(90deg)", "rotate(0deg)"] },
          { duration: reduce ? 0 : 0.24, ease: EASE_OUT_EXPO },
        ),
      );

      // Reopened while closing: leave it open.
      if (current === generation && menu!.matches(":popover-open")) menu!.hidePopover();
    }

    applyClosedState();

    toggle.addEventListener("click", () => (isOpen ? closeMenu() : openMenu()));

    const supportsPageSwap = "onpageswap" in window;
    menu.addEventListener("click", (event) => {
      const target = event.target as Element;
      // Tap on the dark overlay (the popover itself, outside the panel).
      if (target === menu) closeMenu();
      // Links: where pageswap exists the menu is closed there, instantly.
      else if (target.closest("a") && !supportsPageSwap) closeMenu();
    });

    // Right before the browser snapshots the page for the view transition:
    // close with no animation so the snapshot shows a closed menu.
    window.addEventListener("pageswap", () => {
      if (isOpen) closeMenu({ instant: true });
    });
    // Restored from the back/forward cache: make sure it's closed.
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) closeMenu({ instant: true });
    });

    // The toggle disappears at desktop width; don't leave the menu stranded open.
    matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
      if (event.matches && isOpen) closeMenu({ instant: true });
    });
  }
</script>
