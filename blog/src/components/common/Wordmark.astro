---
import { Image } from "astro:assets";
import logo from "../../assets/logo.png";

// Logo and name linking home. Used in both the header and the footer.
---

<a
  href="/"
  class="inline-flex items-center gap-3 rounded-md text-[0.9375rem] font-bold tracking-[0.18em] whitespace-nowrap text-ink [font-stretch:125%]"
  aria-label="Earth Doom home"
>
  <Image src={logo} alt="" width={36} height={36} densities={[1, 2]} loading="eager" class="size-9" />
  <span aria-hidden="true">EARTH DOOM</span>
</a>
