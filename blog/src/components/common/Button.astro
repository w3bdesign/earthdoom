---
import type { HTMLAttributes } from "astro/types";

/**
 * Game button spec (game/DESIGN.md): 6px radius, semibold, one primary per area.
 * Renders a link when `href` is given, otherwise a <button>.
 */
type Props = (HTMLAttributes<"a"> | HTMLAttributes<"button">) & {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
};

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  ...rest
} = Astro.props as Props;

const base =
  "inline-flex shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-md font-semibold transition-[background-color,border-color,color,translate] duration-150 ease-out active:translate-y-px";

const sizes = {
  md: "h-10 px-4 text-sm",
  lg: "h-13 px-7 text-base",
};

const variants = {
  primary: "bg-accent text-accent-ink hover:bg-accent-strong",
  secondary:
    "border border-line-strong bg-raised text-ink hover:border-field hover:bg-line",
  ghost: "text-muted hover:bg-raised hover:text-ink",
};

const classes = [base, sizes[size], variants[variant], className].join(" ");
---

{
  href ? (
    <a href={href} class={classes} {...(rest as HTMLAttributes<"a">)}>
      <slot />
    </a>
  ) : (
    <button
      type="button"
      class={classes}
      {...(rest as HTMLAttributes<"button">)}
    >
      <slot />
    </button>
  )
}
