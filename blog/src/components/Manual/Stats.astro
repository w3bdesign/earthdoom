---
/** Damage table from the original manual. Rows are targets, columns are attackers. */
const ATTACKERS = ["Infantry", "Shadows", "Goliaths", "Hellspawn", "Ares", "Lucius", "Avengers", "Reaper"];

const ROWS: [string, (string | null)[]][] = [
  ["Infantry", ["0.025", "0.02", "1.6", "0.8", "3.00", null, null, null]],
  ["Shadows", ["0.02", "0.105", "1.2", "0.31", "2.35", null, null, null]],
  ["Goliaths", ["0.015", "0.025", "0.05", "0.3", "0.125", null, null, null]],
  ["Grabbers", ["0.015", "0.015", "0.055", "0.11", "0.135", null, null, null]],
  ["Hellspawn", ["0.0025", "0.027", "0.025", "0.05", "0.18", "0.08", null, null]],
  ["Ares", ["0.0035", "0.025", "0.025", "0.04", "0.05", "0.1", null, null]],
  ["Medusas", ["0.02", "0.005", "0.015", "0.25", "1.00", null, null, null]],
  ["Reaper", ["0.005", "0.04", "0.1", "0.15", "0.25", null, "0.2", null]],
];

const th = "sticky top-0 z-10 h-10 bg-raised px-4 text-xs font-medium whitespace-nowrap text-muted";
const td = "border-t border-line px-4 py-3 text-right whitespace-nowrap text-soft group-hover:bg-raised";
// The first column stays put while the table scrolls sideways.
const stickyCol = "sticky left-0 shadow-[1px_0_0_var(--color-line)]";
---

<section id="damage-table" class="scroll-mt-22 py-12" aria-labelledby="damage-table-title">
  <h2 id="damage-table-title" class="text-[clamp(1.5rem,1.3rem+0.8vw,2rem)] leading-[1.15] font-bold text-ink">
    Damage table
  </h2>
  <p class="mt-5 max-w-[68ch] text-soft">
    How much damage each attacking unit (columns) deals to each target (rows).
    An empty cell means that attacker does not hit that target.
  </p>
  <div
    class="relative mt-6 max-w-full min-w-0 overflow-auto rounded-lg border border-line bg-panel shadow-panel"
    tabindex="0"
    role="region"
    aria-label="Damage table, scrolls sideways"
  >
    <table class="w-full min-w-[46rem] text-sm">
      <thead>
        <tr>
          <th scope="col" class={`${th} ${stickyCol} z-20 text-left`}>Target</th>
          {ATTACKERS.map((a) => <th scope="col" class={`${th} text-right`}>{a}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          ROWS.map(([target, values]) => (
            <tr class="group">
              <th
                scope="row"
                class={`${stickyCol} border-t border-line bg-panel px-4 py-3 text-left font-semibold text-ink group-hover:bg-raised`}
              >
                {target}
              </th>
              {values.map((v) =>
                v === null ? (
                  <td class={`${td} text-muted`}>
                    <span aria-hidden="true">–</span>
                    <span class="sr-only">none</span>
                  </td>
                ) : (
                  <td class={td}>{v}</td>
                ),
              )}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
