---
import BaseHead from "../components/Header/BaseHead.astro";
import Header from "../components/Header/Header.astro";
import Footer from "../components/Footer/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Render the site header. Pages that open with their own call to action can opt out. */
  showHeader?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  noindex = false,
  showHeader = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="fixed top-2 left-2 z-50 -translate-y-20 rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-ink focus:translate-y-0"
      >Skip to content</a
    >
    {showHeader && <Header />}
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
